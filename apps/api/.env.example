# Postgres connection used by Prisma
DATABASE_URL="postgresql://school_voting:school_voting@localhost:5433/school_voting?schema=public"

# JWT
JWT_STUDENT_SECRET="change-me-student-secret"
JWT_ADMIN_SECRET="change-me-admin-secret"
JWT_ACCESS_TOKEN_TTL="1h"
JWT_RESET_TOKEN_TTL="15m"

# Registration: comma-separated list of allowed university email domains
ALLOWED_EMAIL_DOMAINS="s.unikl.edu.my"

# Comma-separated list of origins allowed to call this API from a browser
# (the admin-web dev server by default; add the deployed admin-web origin too)
CORS_ORIGINS="http://localhost:5173"

# Email delivery: "smtp" sends real email via Nodemailer, "mock" logs OTPs to
# the console (and, outside production, exposes GET /dev/last-otp) instead.
EMAIL_MODE="mock"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="School Voting <no-reply@s.unikl.edu.my>"

# Media upload limits (bytes)
MEDIA_MAX_IMAGE_BYTES="5242880"
MEDIA_UPLOAD_ROOT="./uploads"

# Offline/demo seeding — see scripts/seed.ts
SEED_MODE="offline"
SEED_FORCE="false"
SEED_ACTIVATE_DEMO_LIST="true"

# Break-glass super admin password reset — see scripts/reset-super-admin-password.ts.
# Not used anywhere else; keep this out of source control in real deployments.
SUPER_ADMIN_RESET_KEY="change-me-reset-key"

NODE_ENV="development"
PORT="3000"
