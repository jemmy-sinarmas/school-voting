# Expo inlines any EXPO_PUBLIC_* var into the client bundle at build time.
# localhost works for the Expo web preview (same machine as the API).
# For a physical device or Android emulator, replace with the reachable
# address of the API: an Android emulator reaches the host machine at
# 10.0.2.2, a physical device needs your machine's LAN IP.
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"
